# Oracle Tuxedo runtime template.
export TUXDIR=${TUXDIR:-/opt/tuxedo}
export TUXCONFIG=${TUXCONFIG:-$APP_HOME/tuxedo/tuxconfig}
export FLDTBLDIR32=${FLDTBLDIR32:-$APP_HOME/tuxedo-server/fml}
export FIELDTBLS32=${FIELDTBLS32:-cnaps_poc.fml32}
export ULOGPFX=${ULOGPFX:-$APP_HOME/logs/ULOG}
export JOLT_LISTEN=${JOLT_LISTEN:-//127.0.0.1:8000}
export TM_SECURITY_CONFIG=${TM_SECURITY_CONFIG:-NONE}
export TM_ALLOW_NOTLS=${TM_ALLOW_NOTLS:-Y}
export PATH=$TUXDIR/bin:${PATH:-}
export LD_LIBRARY_PATH=$TUXDIR/lib:${LD_LIBRARY_PATH:-}

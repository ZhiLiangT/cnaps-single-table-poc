# Oracle connection template for SQL*Plus and OCI.
export ORACLE_HOST=${ORACLE_HOST:-127.0.0.1}
export ORACLE_PORT=${ORACLE_PORT:-1521}
export ORACLE_SERVICE=${ORACLE_SERVICE:-ORCLCDB}
export ORACLE_USER=${ORACLE_USER:-CNAPS_POC}
export ORACLE_PASSWORD=${ORACLE_PASSWORD:-change_me}
export ORACLE_CONNECT_STRING=${ORACLE_CONNECT_STRING:-//${ORACLE_HOST}:${ORACLE_PORT}/${ORACLE_SERVICE}}
export ORACLE_HOME=${ORACLE_HOME:-/opt/oracle/instantclient}

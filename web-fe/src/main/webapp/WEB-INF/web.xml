<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>ruisui-bank-sim</display-name>

    <context-param>
        <param-name>tuxedo.client.mode</param-name>
        <param-value>mock</param-value>
    </context-param>

    <filter>
        <filter-name>requestContextFilter</filter-name>
        <filter-class>com.ruisui.cnaps.web.filter.RequestContextFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>requestContextFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>healthServlet</servlet-name>
        <servlet-class>com.ruisui.cnaps.web.servlet.HealthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>healthServlet</servlet-name>
        <url-pattern>/api/health</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>dictServlet</servlet-name>
        <servlet-class>com.ruisui.cnaps.web.servlet.DictServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>dictServlet</servlet-name>
        <url-pattern>/api/dicts/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>bankServlet</servlet-name>
        <servlet-class>com.ruisui.cnaps.web.servlet.BankServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>bankServlet</servlet-name>
        <url-pattern>/api/banks</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>cnapsVoucherServlet</servlet-name>
        <servlet-class>com.ruisui.cnaps.web.servlet.CnapsVoucherServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>cnapsVoucherServlet</servlet-name>
        <url-pattern>/api/cnaps/vouchers</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>cnapsVoucherServlet</servlet-name>
        <url-pattern>/api/cnaps/vouchers/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
